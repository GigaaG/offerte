# Vul deze lokaal in voor live HERE geocoding/routing/map tiles.
# Let op: in een volledig statische frontend wordt een VITE_* variabele naar de browser gebundeld.
# Gebruik in productie bij voorkeur een server/proxy zodat de HERE sleutel niet publiek zichtbaar is.
VITE_HERE_API_KEY=YOUR_HERE_API_KEY_HERE
VITE_HERE_GEOCODE_ENDPOINT=https://geocode.search.hereapi.com/v1/geocode
VITE_HERE_ROUTING_ENDPOINT=https://router.hereapi.com/v8/routes
VITE_HERE_TRANSIT_ENDPOINT=https://transit.router.hereapi.com/v8/routes
VITE_HERE_MAP_TILE_ENDPOINT=https://maps.hereapi.com/v3/base/mc
